%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0b6388149f074df6b251f3e99923fb43, type: 3}
  m_Name: TutorialScript
  m_EditorClassIdentifier: TrashTD.Runtime::TrashTD.Data.TutorialScript
  speakerName: COALESCE
  speaker: {fileID: 11400000, guid: 283961a6b078c5345b7b3d935267c003, type: 2}
  mapIntro:
  - action: 0
    text: "Oh! A new Reclaimer! Hi, I'm Coalesce. I patch up the team when things get messy. Welcome to the Calder Basin!"
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 4
  - action: 0
    text: "This is the NERC Development Zone on our old survey map. Drag to look around, and scroll to zoom in and out."
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 0
  - action: 0
    text: "Each marker is a stage: a polluted site we need to reclaim. Clicking one opens its dossier, with the enemy routes and a short brief."
    highlight: 9
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 1
    emote: 5
  - action: 0
    text: "Before you head out there, let's run a training drill together. STAGE 00 is our orientation grid, right here by the lake."
    highlight: 9
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 5
  - action: 10
    text: "Open STAGE 00 and press PLAY. Already know the ropes? You can skip the tutorial."
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 1
  steps:
  - action: 0
    text: "Welcome to the orientation grid! I'm Coalesce, and this is your very first drill. Don't worry, we'll take it one step at a time."
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 1
    condition: 1
  - action: 0
    text: "Welcome back to the orientation grid! Here for a refresher? Same drill as before. I'll run you through it again."
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 1
    condition: 2
  - action: 0
    text: "Out in the Basin it's sludge and scrap. In here it's just green lines and practice hostiles. Perfect for learning the ropes."
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 0
  - action: 1
    text: "Hostiles crawl in from the SPAWN on the left and follow this lit route to the EXIT on the right."
    highlight: 8
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 5
  - action: 0
    text: "Every hostile that reaches the exit costs us a life, and we only have 3 here. Lose them all and the stage is lost, even this one. So let's keep them out!"
    highlight: 1
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 3
  - action: 0
    text: "We don't bring a ready-made squad. Before every wave you draft ONE card out of three. Each card is an operator you can deploy."
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 2
  - action: 2
    text: "Pick CHI PAW: click its card, then press the button under its details."
    highlight: 0
    operatorData: {fileID: 11400000, guid: b6c6f5ad90104e25a13e6c61c91b8a04, type: 2}
    enemyData: {fileID: 0}
    cards:
    - {fileID: 11400000, guid: d5f2952e9ace51e4eabe69d1b809048c, type: 2}
    - {fileID: 11400000, guid: b6c6f5ad90104e25a13e6c61c91b8a04, type: 2}
    - {fileID: 11400000, guid: 5ca0ab397aa150b4b80a9456a7d66ac4, type: 2}
    count: 1
    stageNumber: 0
    emote: 5
  - action: 0
    text: "Nice! Drafted cards wait in your deck down here. Deploying is free. You're only limited by your deck and the squad size."
    highlight: 2
    operatorData: {fileID: 11400000, guid: b6c6f5ad90104e25a13e6c61c91b8a04, type: 2}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 1
  - action: 0
    text: "Chi Paw is a Guard, a melee fighter. Melee operators stand on the low ground, right on the enemy route."
    highlight: 5
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 0
  - action: 3
    text: "Click Chi Paw in your deck, then a glowing tile. Hold and drag toward the spawn so it faces left, then let go."
    highlight: 0
    operatorData: {fileID: 11400000, guid: b6c6f5ad90104e25a13e6c61c91b8a04, type: 2}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 5
  - action: 0
    text: "Chi Paw BLOCKS hostiles that walk into it and holds them in place while it fights. Blocking is how we stop the line."
    highlight: 7
    operatorData: {fileID: 11400000, guid: b6c6f5ad90104e25a13e6c61c91b8a04, type: 2}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 0
  - action: 4
    text: "Ready? Press START WAVE."
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 4
  - action: 6
    text: ""
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 0
  - action: 0
    text: "Those were Sludge Grunts: slow, soft, and everywhere. You'll meet plenty more."
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 1
  - action: 0
    text: "And not a single one got through. Great work!"
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 1
    condition: 3
  - action: 0
    text: "A few slipped past, but that's okay! Keep Chi Paw right on their route, facing the spawn, and it'll catch them."
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 0
    condition: 4
  - action: 0
    text: "Phew, that was close! Only one life left. Don't worry, we'll tighten up the line together. You've got this."
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 3
    condition: 5
  - action: 0
    text: "New wave, new draft. This time let's get someone who can shoot from a distance."
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 2
  - action: 2
    text: "Pick DEADEYE."
    highlight: 0
    operatorData: {fileID: 11400000, guid: e8143c7d70005824fa235b98db549a4d, type: 2}
    enemyData: {fileID: 0}
    cards:
    - {fileID: 11400000, guid: 3f1f498433f3fbe44b58b63e8c36bb7f, type: 2}
    - {fileID: 11400000, guid: e8143c7d70005824fa235b98db549a4d, type: 2}
    - {fileID: 11400000, guid: 283961a6b078c5345b7b3d935267c003, type: 2}
    count: 1
    stageNumber: 0
    emote: 5
  - action: 0
    text: "Deadeye is a Sniper. Ranged operators can't stand on the route. They go on the raised high ground beside it."
    highlight: 6
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 0
  - action: 3
    text: "Deploy Deadeye on a glowing high-ground tile. While you place it, the green squares show its range: keep the route inside it."
    highlight: 0
    operatorData: {fileID: 11400000, guid: e8143c7d70005824fa235b98db549a4d, type: 2}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 5
  - action: 4
    text: "Press START WAVE."
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 0
  - action: 5
    text: ""
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 11400000, guid: 81de7f1050c775a4596673009df613f1, type: 2}
    cards: []
    count: 1
    stageNumber: 0
    emote: 0
  - action: 0
    text: "See the quick one? That's a TOXIC RUSHER. Rushers are fast, so they need to be stopped early."
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 3
  - action: 6
    text: ""
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 0
  - action: 0
    text: "Two waves and zero leaks. You're a natural!"
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 4
    condition: 3
  - action: 0
    text: "You're doing okay! Keep the route inside Deadeye's range and those rushers won't get far."
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 0
    condition: 4
  - action: 0
    text: "That one hurt, but we're still standing! Stop the fast ones early and we'll be fine."
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 3
    condition: 5
  - action: 0
    text: "Next up is armour. Some hostiles shrug off normal hits, because their DEF soaks up physical damage."
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 2
  - action: 2
    text: "Pick PYROLITE."
    highlight: 0
    operatorData: {fileID: 11400000, guid: 5ca0ab397aa150b4b80a9456a7d66ac4, type: 2}
    enemyData: {fileID: 0}
    cards:
    - {fileID: 11400000, guid: bd3f1ac48d1f44545850e9e1e5b291ff, type: 2}
    - {fileID: 11400000, guid: 5ca0ab397aa150b4b80a9456a7d66ac4, type: 2}
    - {fileID: 11400000, guid: 0c2ec63bcde3474680d3ed11681c2930, type: 2}
    count: 1
    stageNumber: 0
    emote: 5
  - action: 0
    text: "Pyrolite is a Caster. Casters deal ARTS damage, which ignores DEF and goes against RES instead. They hit a small area, too."
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 0
  - action: 3
    text: "Deploy Pyrolite on the high ground, with the route inside its range."
    highlight: 0
    operatorData: {fileID: 11400000, guid: 5ca0ab397aa150b4b80a9456a7d66ac4, type: 2}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 5
  - action: 4
    text: "Press START WAVE."
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 0
  - action: 5
    text: ""
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 11400000, guid: c7fa936f0635e46428569947a7eebcc9, type: 2}
    cards: []
    count: 1
    stageNumber: 0
    emote: 0
  - action: 0
    text: "That big one is a POLLUTION TANK: heavy DEF and lots of HP. Physical hits barely scratch it, so Pyrolite's Arts do the real work."
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 3
  - action: 6
    text: ""
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 0
  - action: 0
    text: "Your team is taking hits, so... let me join you! Medics heal the operators in their range."
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 4
  - action: 2
    text: "Pick me! The COALESCE card."
    highlight: 0
    operatorData: {fileID: 11400000, guid: 283961a6b078c5345b7b3d935267c003, type: 2}
    enemyData: {fileID: 0}
    cards:
    - {fileID: 11400000, guid: d5f2952e9ace51e4eabe69d1b809048c, type: 2}
    - {fileID: 11400000, guid: 283961a6b078c5345b7b3d935267c003, type: 2}
    - {fileID: 11400000, guid: f506c3c0ae460404f99e2b76402a40a3, type: 2}
    count: 1
    stageNumber: 0
    emote: 1
  - action: 3
    text: "Put me on the high ground near Chi Paw, so Chi Paw is inside my range."
    highlight: 0
    operatorData: {fileID: 11400000, guid: 283961a6b078c5345b7b3d935267c003, type: 2}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 5
  - action: 0
    text: "Heads up: this wave has flyers. Flying hostiles pass over blockers. Only ranged operators and casters can hit them."
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 3
  - action: 4
    text: "Press START WAVE."
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 0
  - action: 5
    text: ""
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 11400000, guid: 9a3e7c1d5b4f48a6c2d0e8f6b4a1c9d9, type: 2}
    cards: []
    count: 1
    stageNumber: 0
    emote: 0
  - action: 0
    text: "A SKYSHARD! It flies right over Chi Paw and shoots back. Deadeye and Pyrolite can hit it, but Chi Paw can't reach the sky."
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 3
  - action: 6
    text: ""
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 0
  - action: 0
    text: "You're doing great! Not a single leak so far."
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 1
    condition: 3
  - action: 0
    text: "You're doing okay. A couple got by, but you're learning fast."
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 0
    condition: 4
  - action: 0
    text: "It's been a rough drill, but don't give up! One more blocker will make a big difference."
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 3
    condition: 5
  - action: 0
    text: "Now let's add a wall that can hold more than one hostile."
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 2
  - action: 2
    text: "Pick BULKHEAD, a Defender. Defenders are tough and can block several hostiles at once."
    highlight: 0
    operatorData: {fileID: 11400000, guid: d5f2952e9ace51e4eabe69d1b809048c, type: 2}
    enemyData: {fileID: 0}
    cards:
    - {fileID: 11400000, guid: d5f2952e9ace51e4eabe69d1b809048c, type: 2}
    - {fileID: 11400000, guid: 3f1f498433f3fbe44b58b63e8c36bb7f, type: 2}
    - {fileID: 11400000, guid: e8143c7d70005824fa235b98db549a4d, type: 2}
    count: 1
    stageNumber: 0
    emote: 5
  - action: 3
    text: "Deploy Bulkhead on the route, facing the spawn."
    highlight: 0
    operatorData: {fileID: 11400000, guid: d5f2952e9ace51e4eabe69d1b809048c, type: 2}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 5
  - action: 0
    text: "One more trick: upgrades. Three copies of the same operator merge into a stronger one, one star higher."
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 2
  - action: 7
    text: "Here, two extra Chi Paw cards for you. The third copy is out on the field..."
    highlight: 2
    operatorData: {fileID: 11400000, guid: b6c6f5ad90104e25a13e6c61c91b8a04, type: 2}
    enemyData: {fileID: 0}
    cards: []
    count: 2
    stageNumber: 0
    emote: 1
    condition: 6
  - action: 7
    text: "Chi Paw's card is already back in your deck, so here are two more copies to go with it..."
    highlight: 2
    operatorData: {fileID: 11400000, guid: b6c6f5ad90104e25a13e6c61c91b8a04, type: 2}
    enemyData: {fileID: 0}
    cards: []
    count: 2
    stageNumber: 0
    emote: 0
    condition: 7
  - action: 7
    text: "Oh! Chi Paw got knocked out earlier. No worries, here are three fresh Chi Paw cards..."
    highlight: 2
    operatorData: {fileID: 11400000, guid: b6c6f5ad90104e25a13e6c61c91b8a04, type: 2}
    enemyData: {fileID: 0}
    cards: []
    count: 3
    stageNumber: 0
    emote: 2
    condition: 8
  - action: 8
    text: "Now let's recall Chi Paw! Click it on the grid, then press its RETREAT button (or right-click it)."
    highlight: 0
    operatorData: {fileID: 11400000, guid: b6c6f5ad90104e25a13e6c61c91b8a04, type: 2}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 5
    condition: 6
  - action: 0
    text: "Three copies merged into a 2★ Chi Paw! Cards only merge in the deck, so retreating is how you upgrade someone on the field."
    highlight: 2
    operatorData: {fileID: 11400000, guid: b6c6f5ad90104e25a13e6c61c91b8a04, type: 2}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 4
  - action: 0
    text: "Retreated operators sit out a few waves before they can return. Guards don't, though: no recall cooldown at all!"
    highlight: 2
    operatorData: {fileID: 11400000, guid: b6c6f5ad90104e25a13e6c61c91b8a04, type: 2}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 0
  - action: 3
    text: "So Chi Paw can go right back in. Redeploy your 2★ Chi Paw on the route."
    highlight: 0
    operatorData: {fileID: 11400000, guid: b6c6f5ad90104e25a13e6c61c91b8a04, type: 2}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 5
  - action: 0
    text: "Everyone else waits: Snipers and Casters sit out 1 wave, Defenders 2, and Medics 3. A card's Intel file lists it as REDEPLOY."
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 0
  - action: 4
    text: "Press START WAVE."
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 0
  - action: 6
    text: ""
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 0
  - action: 0
    text: "Last drill! This hand is yours to choose."
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 4
  - action: 2
    text: "Pick any card you like, then deploy it wherever it fits."
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards:
    - {fileID: 11400000, guid: bd3f1ac48d1f44545850e9e1e5b291ff, type: 2}
    - {fileID: 11400000, guid: 0c2ec63bcde3474680d3ed11681c2930, type: 2}
    - {fileID: 11400000, guid: 3f1f498433f3fbe44b58b63e8c36bb7f, type: 2}
    count: 1
    stageNumber: 0
    emote: 1
  - action: 4
    text: "Everything at once this time. Press START WAVE when you're ready, and good luck!"
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 4
  - action: 6
    text: ""
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 0
  - action: 0
    text: "A flawless drill! Not one hostile made it through. I'm impressed!"
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 4
    condition: 3
  - action: 0
    text: "We did it, with a few scrapes along the way. That's how everyone starts!"
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 1
    condition: 4
  - action: 0
    text: "We made it, by a whisker! Every clear counts, and you'll only get better from here."
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 1
    condition: 5
  - action: 0
    text: "That's the whole job: draft, deploy, block, and adapt to whatever crawls out of the Basin."
    highlight: 0
    operatorData: {fileID: 0}
    enemyData: {fileID: 0}
    cards: []
    count: 1
    stageNumber: 0
    emote: 0
  - action: 9
    text: "The real stages are waiting on the map. You can replay this drill from STAGE 00 any time. Stay close. I've got you."
